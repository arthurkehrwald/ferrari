# Benutzerdienst (systemctl --user), damit er nach PipeWire startet.
# Läuft ohne Login dank "loginctl enable-linger". Installiert von setup.sh.
[Unit]
Description=Ferrari Festival-Auto
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=notify
WorkingDirectory=@REPO@
# Direkte Ausgabe ohne Desktop (KMS/DRM)
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO@/.venv/bin/python -m ferrari
Restart=always
RestartSec=2
# Die Hauptschleife meldet sich 50-mal pro Sekunde; hängt sie, startet systemd neu.
WatchdogSec=10

[Install]
WantedBy=default.target
